# environments/development/.env
# Static, per-environment settings. APP_VERSION and BUILD_NUMBER are NOT
# set here - they're supplied dynamically by deploy.sh at deploy time
# (from the version being deployed/promoted), so this file only holds
# what's genuinely fixed per environment.

ENVIRONMENT=development
HOST_PORT=3001
LOG_LEVEL=debug
COMPOSE_PROJECT_NAME=xqora-development
